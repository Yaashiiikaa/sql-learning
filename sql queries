--flight details sql which contains 3 tables city,flight,passenger
--it made me to understand about forein key and primary key including auto_increment.
create database travel_db;
use travel_db;
create table city(city_id int auto_increment primary key,
city_name varchar(30) not null,
country_name varchar(30));
create table flight(
flight_id int auto_increment primary key,
from_city int,
to_city int,flight_date date,
foreign key(from_city) references city(city_id),foreign key(to_city) references city(city_id));
