-- Display tables
SELECT * FROM Customers;
SELECT * FROM Orders;

-- 1. INNER JOIN
SELECT c.CustomerName, c.Country, o.OrderID, o.Amount
FROM Customers c
INNER JOIN Orders o
ON c.CustomerID = o.CustomerID;

-- 2. LEFT JOIN
SELECT c.CustomerName, c.Country, o.OrderID, o.Amount
FROM Customers c
LEFT JOIN Orders o
ON c.CustomerID = o.CustomerID;

-- 3. RIGHT JOIN
SELECT c.CustomerName, c.Country, o.OrderID, o.Amount
FROM Customers c
RIGHT JOIN Orders o
ON c.CustomerID = o.CustomerID;

-- 4. FULL OUTER JOIN (Using UNION)
SELECT c.CustomerName, c.Country, o.OrderID, o.Amount
FROM Customers c
LEFT JOIN Orders o
ON c.CustomerID = o.CustomerID

UNION

SELECT c.CustomerName, c.Country, o.OrderID, o.Amount
FROM Customers c
RIGHT JOIN Orders o
ON c.CustomerID = o.CustomerID;

